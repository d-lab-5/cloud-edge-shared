  "cards": [
    {
      "dot": "emerald",
      "title": "Who owns what",
      "items": [
        "template-dlab5-edge owns edge/: cloud.py, sync.py, knowledge.py, jobs.py, chat.py, routes.py, mcp_tools.py",
        "The tool owns edge/settings.py: its prompt, CHAT_ALLOWED, single-valued facts, first-start steps",
        "template-dlab5-cloud owns the Edge API functions and /link"
      ]
    },
    {
      "dot": "rose",
      "title": "The boundaries",
      "items": [
        "routes.py answers to localhost only, refuses writes from other sites and cannot be framed",
        "The cloud takes the tenant from the token row, never from the body",
        "A tenant admin links an edge; an operator can list and revoke, never link"
      ]
    },
    {
      "dot": "cyan",
      "title": "One wire",
      "items": [
        "DH-SPEC-100's device flow, profiled in template-dlab5-cloud's docs/specs/edge-cloud-api.md",
        "Every call carries X-Edge-Version; below MIN_EDGE_VERSION every route answers 426",
        "One edge can hold several connections: sandbox, stage, prod"
      ]
    }
  ]
